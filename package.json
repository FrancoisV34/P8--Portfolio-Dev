{
  "name": "portfolio-dev-fv",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev --host 127.0.0.1",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "npm run build && playwright test --config playwright.auth.config.ts",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env ./scripts/db/migrate.ts",
    "db:check": "node --env-file-if-exists=.env ./scripts/db/check.ts",
    "db:backup": "node --env-file-if-exists=.env ./scripts/db/backup.ts",
    "db:restore": "node --env-file-if-exists=.env ./scripts/db/restore.ts",
    "auth:bootstrap": "node --env-file-if-exists=.env ./scripts/auth/bootstrap.ts",
    "auth:status": "node --env-file-if-exists=.env ./scripts/auth/status.ts",
    "auth:reset-password": "node --env-file-if-exists=.env ./scripts/auth/reset-password.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "better-auth": "^1.7.3",
    "better-sqlite3": "12.11.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "isbot": "^5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.0.0",
    "sass": "^1.93.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
