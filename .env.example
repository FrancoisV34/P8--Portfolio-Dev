# Domaine public de la future application Node, sans sous-dossier.
# npm run dev et npm start chargent .env s'il existe.
# Production : fournir l'origine HTTPS au processus Node ou via l'hébergeur.
SITE_URL=http://localhost:5173

# Fichier privé local. En production : chemin explicite sur le volume persistant.
# Tests : chaque test fournit un chemin temporaire distinct.
DATABASE_PATH=./data/development.sqlite

# Authentification locale : remplir ces valeurs dans .env, jamais dans Git.
# Générer le secret : openssl rand -base64 32
BETTER_AUTH_SECRET=
FINANCE_OWNER_EMAIL=
FINANCE_OWNER_NAME=

# Adresse de la page de connexion privée. Toute autre adresse répond
# « introuvable », /finance compris tant qu'aucune session n'est ouverte.
# Défaut : /co. En production, la définir avec `fly secrets set`, jamais dans
# fly.toml qui est public. Générer : echo /$(openssl rand -hex 6)
PRIVATE_LOGIN_PATH=/co
